# Contraseñas de la base de datos (obligatorias)
# - DB_APP_PASSWORD: usuario gastos_user, que usan la app y phpMyAdmin
# - DB_ROOT_PASSWORD: usuario root de MySQL (phpMyAdmin no permite entrar con él)
# Pon valores largos y aleatorios, por ejemplo: od -An -tx1 -N20 /dev/urandom | tr -d ' \n'
# Solo se aplican al crear la base de datos por primera vez. Para cambiarlas en
# una instalación existente: ./scripts/cambiar_contrasenas_bd.sh
DB_APP_PASSWORD=
DB_ROOT_PASSWORD=

# Configuración SMTP para envío de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_aplicacion
SMTP_FROM=tu_correo@gmail.com

# Bot de Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_bot_aqui

# Análisis con IA: modelos de Google Gemini (opcional), separados por comas. Se
# prueban en orden si uno está saturado o sin cuota. Cada usuario guarda su
# propia clave API de Google AI Studio en Configuración → Análisis IA
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash

# URL del repositorio GitHub
GITHUB_REPO_URL=https://github.com/tu-usuario/gestion-gastos

# Configuración de la aplicación
APP_URL=http://localhost:3000
API_URL=http://localhost:8080/api